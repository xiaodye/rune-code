LLM_MODEL=doubao-seed-1-6-lite-251015

LLM_API_BASE=xxx

LLM_API_KEY=xxxx

LLM_TEMPERATURE=0

# 单次最大输出 token 数，可选。不设置则用 API 默认值（通常等于模型最大输出）
# DeepSeek: 最大 8192 | GPT-4o: 最大 16384 | Claude: 最大 8192
LLM_MAX_TOKENS=8192

# 模型上下文窗口大小（输入 token 上限），可选。不设置则兜底 128K。
# 影响 UI 进度条显示和 summarizationMiddleware 的 fraction 计算。
# 换模型时记得同步修改（如 deepseek-v4-flash = 1M, gpt-4o = 128K, claude-sonnet-4 = 200K）
# LLM_CONTEXT_WINDOW=128000

LANGSMITH_API_KEY=xxx

